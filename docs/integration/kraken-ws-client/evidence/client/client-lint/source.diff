@@ -0,0 +1,69 @@
+"""Finite data-pilot configuration and recorded user approval; neither is a credential."""
+
+from typing import Literal
+
+from pydantic import Field
+
+from bot_trader.core.errors import AccessDenied
+from bot_trader.core.events import Digest, ImmutableV2, Nanoseconds, content_hash
+from bot_trader.market_data.capture import CaptureLimits
+
+
+class PilotConfiguration(ImmutableV2):
+    version: Literal["kraken-public-pilot-v1"] = "kraken-public-pilot-v1"
+    mode: Literal["public_data_qa"] = "public_data_qa"
+    synthetic: Literal[False] = False
+    symbol: Literal["BTC/EUR"] = "BTC/EUR"
+    endpoint: Literal["wss://ws.kraken.com/v2"] = "wss://ws.kraken.com/v2"
+    partition: Literal["development"] = "development"
+    max_duration_ns: int = Field(
+        default=300_000_000_000, strict=True, ge=300_000_000_000, le=600_000_000_000
+    )
+    receive_timeout_ns: int = Field(default=1_000_000_000, strict=True, gt=0, le=2_000_000_000)
+    handshake_timeout_ns: int = Field(default=15_000_000_000, strict=True, gt=0, le=30_000_000_000)
+    idle_timeout_ns: int = Field(default=15_000_000_000, strict=True, gt=0, le=30_000_000_000)
+    max_reconnects: int = Field(default=2, strict=True, ge=0, le=5)
+    reconnect_delay_ns: int = Field(default=5_000_000_000, strict=True, gt=0, le=10_000_000_000)
+    max_market_rows: int = Field(default=8000, strict=True, ge=1, le=9000)
+    rights_reference: str = Field(min_length=1, max_length=1024)
+    limits: CaptureLimits = CaptureLimits(
+        max_frames=10_000,
+        max_records=20_000,
+        max_total_bytes=67_108_864,
+        min_free_disk_bytes=134_217_728,
+    )
+
+    @property
+    def digest(self) -> str:
+        return content_hash(self.model_dump(mode="json"))
+
+
+class PilotApproval(ImmutableV2):
+    version: Literal["public-capture-approval-v1"] = "public-capture-approval-v1"
+    approved: bool = Field(default=False, strict=True)
+    purpose: Literal["public_data_qa"] = "public_data_qa"
+    capture_id: str = Field(min_length=1, max_length=64)
+    config_hash: Digest
+    approved_by: str = Field(min_length=1, max_length=200)
+    decision_reference: str = Field(min_length=1, max_length=1024)
+    rights_reference: str = Field(min_length=1, max_length=1024)
+    host_id: str = Field(min_length=1, max_length=255)
+    not_before_ns: Nanoseconds
+    expires_ns: Nanoseconds
+
+    def require(
+        self, capture_id: str, config: PilotConfiguration, now_ns: int, host_id: str
+    ) -> None:
+        approval = PilotApproval.model_validate(self.model_dump())
+        if (
+            not approval.approved
+            or approval.capture_id != capture_id
+            or approval.config_hash != config.digest
+            or approval.host_id != host_id
+            or approval.rights_reference != config.rights_reference
+            or not approval.not_before_ns <= now_ns
+            or now_ns + config.max_duration_ns + 15_000_000_000 > approval.expires_ns
+        ):
+            raise AccessDenied(
+                "A matching, current user approval for this finite public pilot is required."
+            )
diff --git a/src/bot_trader/market_data/capture_cli.py b/src/bot_trader/market_data/capture_cli.py
new file mode 100644
index 0000000..3304644
--- /dev/null
+++ b/src/bot_trader/market_data/capture_cli.py
@@ -0,0 +1,109 @@
+"""Finite pilot command orchestration; dry plan is the default and never opens a socket."""
+
+import importlib.metadata
+import signal
+import socket
+import threading
+import time
+from argparse import Namespace
+from typing import Any
+
+from bot_trader.application import build_services
+from bot_trader.core.contracts import Principal
+from bot_trader.core.events import canonical_bytes
+from bot_trader.core.settings import Settings
+from bot_trader.market_data.capture_authority import PilotApproval, PilotConfiguration
+
+
+class SystemReceiptClock:
+    def __init__(self) -> None:
+        self.stopped = threading.Event()
+
+    def now(self) -> tuple[int, int]:
+        return time.time_ns(), time.monotonic_ns()
+
+    def sleep_ns(self, duration_ns: int) -> None:
+        self.stopped.wait(duration_ns / 1_000_000_000)
+
+
+def execute_command(args: Namespace, settings: Settings) -> dict[str, Any]:
+    config = PilotConfiguration.model_validate_json(args.config.read_bytes())
+    try:
+        installed = importlib.metadata.version("websockets")
+    except importlib.metadata.PackageNotFoundError:
+        installed = None
+    if not (args.execute or args.inspect or args.recover_stopped_writer):
+        return {
+            "status": "plan_only",
+            "network_contacted": False,
+            "capture_id": args.capture_id,
+            "config_hash": config.digest,
+            "config": config.model_dump(mode="json"),
+            "websockets_required": "17.4",
+            "websockets_installed": installed,
+            "host_id": socket.gethostname(),
+            "execution_authorized": False,
+            "requires": [
+                "explicit user approval matching this plan",
+                "applicable retention rights",
+                "synchronized host clock and private POSIX disk",
+                "external wall-time watchdog",
+            ],
+            "normalization_artifact_limit_bytes": 33_554_432,
+        }
+    clock = SystemReceiptClock()
+    approval = None
+    if args.execute:
+        if args.approval is None:
+            raise ValueError("Provide the separately authorized finite pilot approval record.")
+        approval = PilotApproval.model_validate_json(args.approval.read_bytes())
+        approval.require(args.capture_id, config, clock.now()[0], socket.gethostname())
+    if args.execute and installed != "17.4":
+        raise ValueError("Install the pinned optional capture extra before an approved pilot.")
+    # Dedicated pilot state; larger bounded sidecars don't change the platform default.
+    settings = settings.model_copy(update={"max_artifact_bytes": 33_554_432})
+    services = build_services(settings)
+    administrator = Principal(id="local-admin", role="admin")
+    stopped = clock.stopped
+    handlers: dict[signal.Signals, Any] = {}
+    try:
+        if args.inspect:
+            report = services.capture.inspect(args.capture_id, config, administrator)
+        elif args.recover_stopped_writer:
+            journal = services.capture.journal(args.capture_id, config, administrator)
+            with journal.capture_lease():
+                recovered = journal.recover(
+                    writer_stopped=True,
+                    session_id="recovery-" + str(clock.now()[0]),
+                    received_ns=clock.now()[0],
+                    monotonic_ns=clock.now()[1],
+                )
+            report = {
+                "status": "recovery_recorded",
+                "network_contacted": False,
+                "recovered": recovered.model_dump(mode="json") if recovered else None,
+            }
+        else:
+            from bot_trader.market_data.kraken_transport import KrakenWebSocketTransport
+
+            for signum in (signal.SIGINT, signal.SIGTERM):
+                handlers[signum] = signal.signal(signum, lambda *_: stopped.set())
+            assert approval is not None
+            report = services.capture.run_public_pilot(
+                args.capture_id,
+                config,
+                administrator,
+                approval,
+                clock=clock,
+                factory=lambda _: KrakenWebSocketTransport(
+                    max_frame_bytes=config.limits.max_frame_bytes
+                ),
+                stop_requested=stopped.is_set,
+            )
+        # Persist a content-addressed technical receipt. No market rows are printed.
+        digest = services.capture.store.put(canonical_bytes(report), "json")
+        return {**report, "report_hash": digest}
+    finally:
+        for signum, handler in handlers.items():
+            signal.signal(signum, handler)
+        services.database.close()
